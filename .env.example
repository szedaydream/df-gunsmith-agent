# ============ 大模型配置（任何 OpenAI 兼容厂商）============
# 硅基流动示例：
LLM_API_KEY=sk-在这里填你的key
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=Qwen/Qwen3-8B

# DeepSeek 示例：
# LLM_API_KEY=你的deepseek_key
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# Kimi 示例：
# LLM_API_KEY=你的kimi_key
# LLM_BASE_URL=https://api.moonshot.cn/v1
# LLM_MODEL=moonshot-v1-8k

# ============ 搜索服务配置 ============
# 可选值：none（不搜索）/ bocha / tavily / kimi_builtin（仅 Kimi 模型可用）
#
# ⚠️ 已知问题（2026-10 实测）：kimi_builtin（模型内置联网搜索）在
#    kimi-k3 / kimi-k2.6 上报 400 "Invalid request: tokenization failed"。
#    kimi-k2.5 时代是正常的 —— 换模型后，内置搜索的结果回填格式不再兼容。
#    实测：把 SEARCH_PROVIDER 设为 none，整条流水线（意图判断→生成→质检→修正）
#    完全正常，输出质量不受影响，只是少了实时资料。
#    恢复联网搜索的两条路：
#      1) 换独立搜索服务：SEARCH_PROVIDER=bocha（或 tavily）+ 填 SEARCH_API_KEY
#         —— 推荐，顺便验证了本项目「搜索可插拔」的设计
#      2) 修 services/ai_service.py 里内置搜索的结果回填格式，对齐新模型
SEARCH_PROVIDER=none
SEARCH_API_KEY=

# ============ Flask 配置 ============
SECRET_KEY=换成一串随机字符
DEBUG=True
HOST=127.0.0.1
PORT=5000
